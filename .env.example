# Application
APP_ENV=development
WORKER_POOL_SIZE=0

# External Ports (to access from your host machine)
GRPC_EXTERNAL_PORT=50052
HEALTH_EXTERNAL_PORT=8082

# Kafka
KAFKA_BROKERS=host.docker.internal:9092
KAFKA_GROUP_ID=image-processor-go
KAFKA_TOPIC_INPUT=image.processing.requested
KAFKA_TOPIC_OUTPUT=image.processing.completed
# true is a development-only convenience: it replays the entire input topic on
# any GroupID change or once offsets expire. In production this must be false.
KAFKA_START_FROM_BEGINNING=false
# Dead-letter topic suffix, appended to the input topic name (e.g. image.processing.requested.dlq).
KAFKA_DLQ_SUFFIX=.dlq
# Max in-message delivery attempts before a message is routed to the DLQ.
KAFKA_MAX_DELIVERY_TRIES=3
# Initial retry backoff; doubles after each failed attempt.
KAFKA_RETRY_BACKOFF=500ms

# Processing
# Per-message handler timeout. Must exceed the p99.9 of file_processor_duration_seconds
# plus S3 round-trips, or healthy messages will be needlessly retried/dead-lettered.
PROCESS_TIMEOUT=120s

# S3 Storage (MinIO/RustFS)
STORAGE_ENDPOINT=host.docker.internal:9000
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_SSL=false

# Performance (libvips)
VIPS_MAX_CACHE=0
VIPS_MAX_CACHE_MEM=0
WEBP_QUALITY=80
