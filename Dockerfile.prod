# syntax=docker/dockerfile:1.4
# Stage 1: Build the Go application
FROM golang:1.23-alpine3.20 AS builder

# Install build dependencies for bimg/libvips
# bimg requires vips-dev, build-base, and pkgconfig
RUN apk add --no-cache \
    vips-dev \
    build-base \
    pkgconfig

WORKDIR /app

# Copy dependency files and download
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy the source code
COPY . .

# Build the application
# We use CGO_ENABLED=1 because bimg is a CGO wrapper around libvips
# We use BuildKit cache mounts to prevent the massive CGO build cache from blowing up the container disk limit
# Using -ldflags="-s -w" to strip debug information and reduce binary size
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -v -o server ./cmd/server/main.go

# Stage 2: Final minimal image
FROM alpine:3.20

# Install runtime dependencies for libvips, CA certificates for S3, and tzdata
RUN apk add --no-cache \
    vips \
    ca-certificates \
    tzdata

# Create a non-root user for security
RUN adduser -D -g '' -h /app -u 10001 appuser

WORKDIR /app

# Copy the binary from the builder stage and change ownership
COPY --from=builder --chown=appuser:appuser /app/server .

# Switch to non-root user
USER appuser

# Expose gRPC port and Health/Metrics port
EXPOSE 50051 8081

# Command to run
ENTRYPOINT ["./server"]
